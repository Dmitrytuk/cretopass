# Maintainer: Your Name <email@example.com>

pkgname=cretopass
pkgver=1.0.0
pkgrel=1
pkgdesc="Terminal-based secret keeper with vim-style navigation, age-encrypted file storage, and in-memory editing"
arch=('x86_64')
url="https://github.com/cretopass/cretopass"
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "$pkgname-$pkgver"
	cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
	cd "$pkgname-$pkgver"
	CARGO_TARGET_DIR=target
	cargo build --release --frozen --target "$CARCH-unknown-linux-gnu"
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 "target/$CARCH-unknown-linux-gnu/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

	install -Dm644 packaging/cretopass.1 "$pkgdir/usr/share/man/man1/$pkgname.1"
	install -Dm644 packaging/cretopass.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"

	install -Dm644 packaging/completions/cretopass.bash "$pkgdir/usr/share/bash-completion/completions/$pkgname"
	install -Dm644 packaging/completions/cretopass.zsh "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
	install -Dm644 packaging/completions/cretopass.fish "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 LICENSE-THIRD-PARTY "$pkgdir/usr/share/licenses/$pkgname/LICENSE-THIRD-PARTY"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
